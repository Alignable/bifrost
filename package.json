{
  "name": "bifrost",
  "description": "Bridge from Turbolinks to Vite",
  "workspaces": [
    "bifrost",
    "bifrost-fastify",
    "tests/*"
  ],
  "scripts": {
    "test": "npm run -w=tests-playwright test",
    "build": "npm run -w=bifrost -w=bifrost-fastify build",
    "publish": "npm -w=bifrost -w=bifrost-fastify publish --access public"
  },
  "overrides": {
    "vike": "$vike"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "vike": "0.4.259-commit-2fe6cc7"
  }
}
